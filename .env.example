# Copy to .env for `docker compose` or export in your shell. All are optional in development.

# PostgreSQL. Without it the API uses an embedded PGlite database (in memory, or PGLITE_DIR).
# DATABASE_URL=postgres://praat:praat@localhost:5432/praat
# PGLITE_DIR=./data/pglite

# Required in production: at least 32 random characters (openssl rand -base64 48).
# JWT_SECRET=

# Claude: enables the AI conversation partner. Without a key the offline partner answers.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=low
# AI_MAX_TOKENS=4000
# Server-side refusal fallbacks (beta). Set to false behind gateways that reject beta parameters.
# AI_FALLBACKS=true
# AI_DAILY_TURN_LIMIT=200

# HTTP
# PORT=8787
# CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=true
# TRUST_PROXY=false
# WEB_DIST_DIR=../web/dist
# MIGRATE_ON_START=false
